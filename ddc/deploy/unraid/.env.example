# Copy to .env in the Compose Manager stack folder and fill in.

# Public address people open InvoiceShelf at, and its bare host name.
APP_URL=https://invoices.example.com
APP_DOMAIN=invoices.example.com

# Host port (DDC uses 5000; pick one that is free).
INVOICESHELF_PORT=8091

# appdata folder; storage/ and modules/ are created inside it.
# Both must be writable by uid 82 (www-data in the image):
#   mkdir -p /mnt/user/appdata/invoiceshelf-ddc/{storage,modules}
#   chown -R 82:82 /mnt/user/appdata/invoiceshelf-ddc
INVOICESHELF_DATA_DIR=/mnt/user/appdata/invoiceshelf-ddc

# Pin an exact build (e.g. 3.0.0-alpha.15-ddc0.1.0) or follow latest.
INVOICESHELF_DDC_TAG=latest

APP_NAME=Drone Data Command Invoicing
